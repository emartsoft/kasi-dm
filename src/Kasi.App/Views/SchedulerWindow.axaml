<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kasi.App.ViewModels"
        xmlns:core="using:Kasi.Core"
        xmlns:res="using:Kasi.App.Resources"
        x:Class="Kasi.App.Views.SchedulerWindow"
        x:DataType="vm:SchedulerViewModel"
        Title="{x:Static res:Strings.SchedulerTitle}"
        AutomationProperties.Name="{x:Static res:Strings.SchedulerTitle}"
        Width="560"
        Height="620"
        MinWidth="440"
        MinHeight="400"
        Background="{DynamicResource KasiBaseBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource KasiDangerBrush}" VerticalAlignment="Center" AutomationProperties.Name="{Binding StatusText}" />
      <Button Content="{x:Static res:Strings.SchedulerSave}" Command="{Binding SaveCommand}" IsDefault="True" Classes="accent" AutomationProperties.Name="{x:Static res:Strings.SchedulerSave}" />
      <Button Content="{x:Static res:Strings.SchedulerCancel}" Command="{Binding CancelCommand}" IsCancel="True" AutomationProperties.Name="{x:Static res:Strings.SchedulerCancel}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="{x:Static res:Strings.SchedulerQueueLabel}" VerticalAlignment="Center" Classes="kasi-secondary" />
      <ComboBox ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}" Width="200" AutomationProperties.Name="{x:Static res:Strings.SchedulerSelectQueue}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:Queue">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.SchedulerWakeWarning}" IsVisible="{Binding WakeTimerWarning}" Foreground="{DynamicResource KasiDangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="{x:Static res:Strings.SchedulerWakeWarning}" />

    <TabControl>
      <TabItem Header="{x:Static res:Strings.SchedulerTabQueue}" AutomationProperties.Name="{x:Static res:Strings.SchedulerTabQueue}">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <TextBlock Text="{x:Static res:Strings.SchedulerMaxParallel}" Classes="kasi-secondary" />
          <NumericUpDown Value="{Binding MaxParallel}" Minimum="1" Maximum="20" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.SchedulerMaxParallelName}" />

          <TextBlock Text="{x:Static res:Strings.SchedulerQuota}" Classes="kasi-secondary" Margin="0,8,0,0" />
          <CheckBox Content="{x:Static res:Strings.SchedulerQuotaEnable}" IsChecked="{Binding QuotaEnabled}" AutomationProperties.Name="{x:Static res:Strings.SchedulerQuotaEnableName}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding QuotaEnabled}">
            <NumericUpDown Value="{Binding QuotaGigabytes}" Minimum="0.1" Maximum="1000000" Increment="0.5" FormatString="0.##" Width="140" AutomationProperties.Name="{x:Static res:Strings.SchedulerQuotaSizeName}" />
            <TextBlock Text="{x:Static res:Strings.SchedulerQuotaUnit}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding QuotaResets}" SelectedItem="{Binding SelectedQuotaReset}" Width="160" AutomationProperties.Name="{x:Static res:Strings.SchedulerQuotaResetName}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuotaResetChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="{x:Static res:Strings.SchedulerQuotaSoft}" Classes="kasi-secondary" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.SchedulerTabSchedule}" AutomationProperties.Name="{x:Static res:Strings.SchedulerTabSchedule}">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <CheckBox Content="{x:Static res:Strings.SchedulerEnable}" IsChecked="{Binding IsScheduleEnabled}" AutomationProperties.Name="{x:Static res:Strings.SchedulerEnable}" />

            <Grid ColumnDefinitions="140,140" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.SchedulerStartLabel}" Classes="kasi-secondary" />
              <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding StartTimeText}" Width="110" HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerStartName}" />

              <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.SchedulerStopLabel}" Classes="kasi-secondary" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StopTimeText}" IsEnabled="{Binding !RunUntilEmpty}" Width="110" HorizontalAlignment="Left" Margin="0,4,0,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerStopName}" />
            </Grid>

            <CheckBox Content="{x:Static res:Strings.SchedulerUntilEmpty}" IsChecked="{Binding RunUntilEmpty}" AutomationProperties.Name="{x:Static res:Strings.SchedulerUntilEmptyName}" />

            <TextBlock Text="{x:Static res:Strings.SchedulerActiveDays}" Margin="0,8,0,0" FontWeight="SemiBold" />
            <WrapPanel>
              <CheckBox Content="{x:Static res:Strings.SchedulerDaySun}" IsChecked="{Binding Sunday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDaySunday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDayMon}" IsChecked="{Binding Monday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDayMonday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDayTue}" IsChecked="{Binding Tuesday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDayTuesday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDayWed}" IsChecked="{Binding Wednesday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDayWednesday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDayThu}" IsChecked="{Binding Thursday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDayThursday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDayFri}" IsChecked="{Binding Friday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDayFriday}" />
              <CheckBox Content="{x:Static res:Strings.SchedulerDaySat}" IsChecked="{Binding Saturday}" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.SchedulerDaySaturday}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.SchedulerTabPost}" AutomationProperties.Name="{x:Static res:Strings.SchedulerTabPost}">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="{x:Static res:Strings.SchedulerWhenDone}" Classes="kasi-secondary" />
            <ComboBox ItemsSource="{Binding PostActions}" SelectedItem="{Binding SelectedPostAction}" Width="200" AutomationProperties.Name="{x:Static res:Strings.SchedulerPostActionName}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PostActionChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Content="{x:Static res:Strings.SchedulerForce}" IsChecked="{Binding ForcePostAction}" AutomationProperties.Name="{x:Static res:Strings.SchedulerForceName}" />

            <TextBlock Text="{x:Static res:Strings.SchedulerProgramPath}" Margin="0,8,0,0" Classes="kasi-secondary" />
            <TextBox Text="{Binding ProgramPath}" PlaceholderText="C:\tools\app.exe" AutomationProperties.Name="{x:Static res:Strings.SchedulerProgramPathName}" />

            <TextBlock Text="{x:Static res:Strings.SchedulerProgramArgs}" Classes="kasi-secondary" />
            <TextBox Text="{Binding ProgramArguments}" PlaceholderText="--file %1" AutomationProperties.Name="{x:Static res:Strings.SchedulerProgramArgsName}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
