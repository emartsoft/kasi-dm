<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kasi.App.ViewModels"
        xmlns:res="using:Kasi.App.Resources"
        x:Class="Kasi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        AutomationProperties.Name="{Binding AutomationName}"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <DataGrid ItemsSource="{Binding Jobs.Rows}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserSortColumns="False"
            SelectedItem="{Binding SelectedRow}"
            AutomationProperties.Name="{x:Static res:Strings.JobListAutomationName}">
    <DataGrid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{Binding RefreshLinkLabel}" Command="{Binding RefreshLinkCommand}" AutomationProperties.Name="{Binding RefreshLinkLabel}" />
      </ContextMenu>
    </DataGrid.ContextMenu>
    <DataGrid.Columns>
      <DataGridTextColumn Header="{x:Static res:Strings.JobColumnName}" Binding="{Binding FileName}" Width="*" />
      <DataGridTextColumn Header="{x:Static res:Strings.JobColumnState}" Binding="{Binding State}" Width="120" />
      <DataGridTextColumn Header="{x:Static res:Strings.JobColumnProgress}" Binding="{Binding Percent, StringFormat={}{0:0}%}" Width="100" />
      <DataGridTextColumn Header="{x:Static res:Strings.JobColumnSize}" Binding="{Binding Size}" Width="110" />
    </DataGrid.Columns>
  </DataGrid>
</Window>
