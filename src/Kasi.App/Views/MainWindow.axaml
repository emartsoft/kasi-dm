<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kasi.App.ViewModels"
        xmlns:tray="using:Kasi.App.Tray"
        xmlns:res="using:Kasi.App.Resources"
        x:Class="Kasi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        AutomationProperties.Name="{Binding AutomationName}"
        Width="1280"
        Height="720"
        MinWidth="760"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- the DataGrid's own header colours are not defined by FluentAvalonia's theme, which left the header text black on a dark window -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding AddUrlCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <!-- toolbar, left to right as in the wireframe, then the search box -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto" AutomationProperties.Name="{x:Static res:Strings.ToolbarAutomationName}">
        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Width="220" Text="{Binding Jobs.SearchText}" PlaceholderText="{x:Static res:Strings.SearchPlaceholder}" AutomationProperties.Name="{x:Static res:Strings.SearchAutomationName}" />
        <WrapPanel Grid.Column="0" Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > Button, WrapPanel > DropDownButton">
              <Setter Property="Margin" Value="0,0,4,4" />
            </Style>
          </WrapPanel.Styles>
          <Button Content="{x:Static res:Strings.ToolbarAddUrl}" Command="{Binding AddUrlCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarAddUrl}" />
          <Button Content="{x:Static res:Strings.ToolbarResume}" Command="{Binding ResumeCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarResume}" />
          <Button Content="{x:Static res:Strings.ToolbarPause}" Command="{Binding PauseCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarPause}" />
          <Button Content="{x:Static res:Strings.ToolbarStop}" Command="{Binding StopCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarStop}" />
          <Button Content="{x:Static res:Strings.ToolbarDelete}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarDelete}" />
          <Button Content="{x:Static res:Strings.ToolbarDeleteCompleted}" Command="{Binding DeleteCompletedCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarDeleteCompleted}" />
          <Button Content="{x:Static res:Strings.ToolbarStartQueue}" Command="{Binding StartQueueCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarStartQueue}" />
          <Button Content="{x:Static res:Strings.ToolbarStopQueue}" Command="{Binding StopQueueCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarStopQueue}" />
          <Button Content="{x:Static res:Strings.ToolbarScheduler}" Command="{Binding SchedulerCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarScheduler}" />
          <DropDownButton Content="{Binding ToolbarSpeedLimitText}" AutomationProperties.Name="{Binding ToolbarSpeedLimitText}">
            <DropDownButton.Flyout>
              <MenuFlyout ItemsSource="{Binding SpeedPresets}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{ReflectionBinding Label}" />
                    <Setter Property="Command" Value="{ReflectionBinding $parent[Window].DataContext.SetSpeedLimitCommand}" />
                    <Setter Property="CommandParameter" Value="{ReflectionBinding}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Content="{x:Static res:Strings.ToolbarSettings}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="{x:Static res:Strings.ToolbarSettings}" />
        </WrapPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <Grid ColumnDefinitions="Auto,24,Auto,24,Auto,*,Auto" AutomationProperties.Name="{x:Static res:Strings.StatusBarAutomationName}">
        <TextBlock Grid.Column="0" Text="{Binding Jobs.TotalSpeedText}" AutomationProperties.Name="{Binding Jobs.TotalSpeedText}" />
        <TextBlock Grid.Column="2" Text="{Binding CountsText}" AutomationProperties.Name="{Binding CountsText}" />
        <TextBlock Grid.Column="4" Text="{Binding SpeedLimitText}" AutomationProperties.Name="{Binding SpeedLimitText}" />
        <TextBlock Grid.Column="6" Text="{Binding ExtensionStatusText}" AutomationProperties.Name="{Binding ExtensionStatusText}" />
      </Grid>
    </Border>

    <!-- sidebar: status filters, categories, queues -->
    <ListBox DockPanel.Dock="Left" Width="190" ItemsSource="{Binding Sidebar.Entries}" SelectedItem="{Binding Sidebar.Selected}" AutomationProperties.Name="{Binding Sidebar.AutomationName}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SidebarEntry">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="{Binding IsHeader, Converter={x:Static vm:SidebarFonts.Weight}}" Opacity="{Binding IsHeader, Converter={x:Static vm:SidebarFonts.Opacity}}" />
            <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.7" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Jobs.Visible}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              GridLinesVisibility="None"
              IsReadOnly="True"
              SelectionMode="Extended"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              AutomationProperties.Name="{x:Static res:Strings.JobListAutomationName}">
      <DataGrid.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding ToggleCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshLinkCommand}" />
        <KeyBinding Gesture="Enter" Command="{Binding OpenRowCommand}" CommandParameter="{Binding SelectedRow}" />
      </DataGrid.KeyBindings>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static res:Strings.ToolbarResume}" Command="{Binding ResumeCommand}" />
          <MenuItem Header="{x:Static res:Strings.ToolbarPause}" Command="{Binding PauseCommand}" />
          <MenuItem Header="{Binding RefreshLinkLabel}" Command="{Binding RefreshLinkCommand}" AutomationProperties.Name="{Binding RefreshLinkLabel}" />
          <MenuItem Header="{x:Static res:Strings.ToolbarDelete}" Command="{Binding DeleteCommand}" />
          <Separator />
          <MenuItem x:Name="ColumnsMenu" Header="{x:Static res:Strings.ColumnsMenu}" AutomationProperties.Name="{x:Static res:Strings.ColumnsMenu}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnName}" Tag="name" Binding="{Binding FileName}" Width="2*" MinWidth="200" />
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnSize}" Tag="size" Binding="{Binding Size}" SortMemberPath="SortSize" Width="90" />
        <DataGridTemplateColumn Header="{x:Static res:Strings.JobColumnProgress}" Tag="progress" SortMemberPath="Percent" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:JobRowViewModel">
              <Grid ColumnDefinitions="*,48" Margin="6,0">
                <ProgressBar Grid.Column="0" MinWidth="0" Margin="0,0,6,0" Value="{Binding Percent}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnSpeed}" Tag="speed" Binding="{Binding Speed}" SortMemberPath="SortSpeed" Width="100" />
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnTimeLeft}" Tag="timeleft" Binding="{Binding TimeLeft}" SortMemberPath="SortTimeLeft" Width="90" />
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnState}" Tag="status" Binding="{Binding State}" Width="110" />
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnDateAdded}" Tag="date" Binding="{Binding DateAdded}" SortMemberPath="Created" Width="130" />
        <DataGridTextColumn Header="{x:Static res:Strings.JobColumnCategory}" Tag="category" Binding="{Binding CategoryName}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
