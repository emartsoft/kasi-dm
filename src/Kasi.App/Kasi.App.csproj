<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows target framework, for the toast notifications (CommunityToolkit.WinUI.Notifications, ADR 0023). -->
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kasi.Core/Kasi.Core.csproj" />
    <ProjectReference Include="../Kasi.Engine/Kasi.Engine.csproj" />
    <ProjectReference Include="../Kasi.Media/Kasi.Media.csproj" />
    <ProjectReference Include="../Kasi.Torrent/Kasi.Torrent.csproj" />
    <ProjectReference Include="../Kasi.Scheduling/Kasi.Scheduling.csproj" />
    <ProjectReference Include="../Kasi.Data/Kasi.Data.csproj" />
    <ProjectReference Include="../Kasi.Ipc/Kasi.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kasi.App.Tests" />
  </ItemGroup>

</Project>
