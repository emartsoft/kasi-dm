<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kasi.Ipc/Kasi.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests drive the relay, the writer and the launcher directly, without a browser. -->
    <InternalsVisibleTo Include="Kasi.NativeHost.Tests" />
    <!-- The nightly fuzz target runs the relay in process (TC-BRW-006). -->
    <InternalsVisibleTo Include="Kasi.Fuzz" />
  </ItemGroup>

</Project>
