{
  "name": "kasi-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "build": "tsx vite.config.ts && npm run check:manifests",
    "build:chromium": "tsx vite.config.ts chromium",
    "build:firefox": "tsx vite.config.ts firefox",
    "generate:types": "tsx scripts/generate-types.ts",
    "check:types": "tsx scripts/generate-types.ts --check",
    "check:manifests": "tsx scripts/check-manifests.ts",
    "lint": "eslint . && tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke:chromium": "tsx tests/browser/chromium-smoke.ts",
    "smoke:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors"
  },
  "dependencies": {
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/webextension-polyfill": "0.12.6",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
