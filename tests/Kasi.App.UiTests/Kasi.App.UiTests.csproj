<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <!-- Kasi.TestServer is an executable project; the tests only use it in process. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kasi.App/Kasi.App.csproj" />
    <ProjectReference Include="../../src/Kasi.Ipc/Kasi.Ipc.csproj" />
    <ProjectReference Include="../Kasi.TestServer/Kasi.TestServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <!-- The app runs from its own published folder (app/): this project takes the ASP.NET shared framework in through Kasi.TestServer, which
       makes the build leave out the Microsoft.Extensions.* assemblies the framework supplies, and Kasi.App.exe runs without that framework. -->
  <Target Name="PublishAppForUiTests" AfterTargets="Build">
    <MSBuild Projects="../../src/Kasi.App/Kasi.App.csproj" Targets="Publish" Properties="NoBuild=true;Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath($(OutDir)))app/" />
  </Target>

</Project>
